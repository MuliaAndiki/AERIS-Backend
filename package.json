{
  "name": "boilerpad-elysia-api",
  "version": "1.0.50",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "dev": "npm run prisma:generate && bun --watch run src/serve.ts",
    "start": "bun run src/serve.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "bun test",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json,md}'"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.36",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^6.18.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.11",
    "ai": "^6.0.170",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.2",
    "elysia": "^1.2.0",
    "groq-sdk": "^1.1.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.1",
    "nodemailer": "^8.0.2",
    "openai": "^6.35.0",
    "prisma": "^6.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.5",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vercel/node": "^3.2.27",
    "bun-types": "^1.3.10",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
